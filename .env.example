# Copy to .env and fill locally. Never commit a real API key.
DEEPSEEK_API_KEY=
# offline disables outbound model requests even when a key is present.
VERALANE_MODEL_MODE=offline
# Official model ID; extraction uses JSON output, and never executes banking actions.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_OUTPUT_TOKENS=768
DEEPSEEK_TIMEOUT_SECONDS=20
# Persistent local lifetime limits, including failures and uncertain requests.
DEEPSEEK_MAX_CALLS=200
DEEPSEEK_MAX_TOTAL_TOKENS=200000
DEEPSEEK_MAX_INFLIGHT=2
# Estimated CNY budget only. The provider's existing balance/spend is unknown.
DEEPSEEK_BUDGET_YUAN=20
# Optional: set BOTH to current conservative CNY / 1M-token prices before calls.
# No live price is assumed. Without prices, call/token guards still apply.
# Adding prices after unpriced attempts blocks model calls (history is unknown).
DEEPSEEK_INPUT_PRICE_PER_MILLION_YUAN=
DEEPSEEK_OUTPUT_PRICE_PER_MILLION_YUAN=
VERALANE_DEMO_DATE=2026-09-30
# Local fictional demo only; 0 disables the clock advancement UI and endpoint.
VERALANE_DEMO_CONTROLS=1
